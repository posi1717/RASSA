# ==========================================
# RASSA - Environment Configuration
# ==========================================

# 1. Google Gemini AI (Powers Ninny AI Personal Tutor live responses)
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# 2. Supabase Backend (Optional: For multi-device cloud sync and authentication)
# Get your project URL and Anon Key from: https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Stripe Billing (Optional: For live credit card payment processing)
# In test mode without these, the app uses seamless mock checkout for full feature access
VITE_STRIPE_CHECKOUT_ENDPOINT=
VITE_STRIPE_PORTAL_URL=
