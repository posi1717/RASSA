# ==========================================
# RASSA - Environment Configuration
# ==========================================

# Google Cloud project metadata
GOOGLE_CLOUD_PROJECT_NAME=RASSAME
GOOGLE_CLOUD_PROJECT_NUMBER=733979547417
GOOGLE_CLOUD_PROJECT_ID=rassame
GOOGLE_CLOUD_AGENT_PLATFORM_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
VITE_AGENT_API_URL=http://127.0.0.1:8000

# 1. Google Gemini AI (Powers Ninny AI Personal Tutor live responses)
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# 2. Supabase Backend (Optional: For multi-device cloud sync and authentication)
# Get your project URL and Anon Key from: https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. Stripe Billing (Optional: For live credit card payment processing)
# In test mode without these, the app uses seamless mock checkout for full feature access
VITE_STRIPE_CHECKOUT_ENDPOINT=
VITE_STRIPE_PORTAL_URL=
